def sanitize_str(s, max_len=60):
    return re.sub(r'[\x00-\x1f\x7f-\x9f]', '', str(s))[:max_len]

def get_hardware_info():
    vendor = "Bilinmiyor"
    model = "Linux Cihazı"
    try:
        if os.path.exists("/sys/class/dmi/id/sys_vendor"):
            with open("/sys/class/dmi/id/sys_vendor", "r", encoding="utf-8", errors="ignore") as f:
                vendor = f.read().strip()
    except Exception:
        pass
    try:
        if os.path.exists("/sys/class/dmi/id/product_name"):
            with open("/sys/class/dmi/id/product_name", "r", encoding="utf-8", errors="ignore") as f:
                model = f.read().strip()
    except Exception:
        pass

    vendor_upper = vendor.upper()
    profile = {
        "badge": f"💻 {vendor}",
        "icon": "󰌢",
        "color": "#38bdf8",
        "accent": "Omarchy Cyber Blue",
        "category": "Personal Computer"
    }

    for key, val in OEM_PROFILES.items():
        if key in vendor_upper:
            profile = val
            break

    return {
        "vendor": sanitize_str(vendor, 40),
        "model": sanitize_str(model, 40),
        "profile": profile
    }

def list_installed_apps():
    apps = []
    search_dirs = [APPS_DIR, "/usr/share/applications"]
    seen_ids = set()

    for d in search_dirs:
        if not os.path.exists(d):
            continue
        for fname in sorted(os.listdir(d)):
            if fname.endswith(".desktop") and fname not in seen_ids:
                fpath = os.path.join(d, fname)
                seen_ids.add(fname)
                try:
                    name = fname[:-8]
                    exec_cmd = ""
                    icon = "application-x-executable"
                    hidden = False
                    categories = ""

                    with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                        for line in f:
                            line = line.strip()
                            if line.startswith("Name=") and name == fname[:-8]:
                                name = line[5:].strip()
                            elif line.startswith("Exec="):
                                exec_cmd = line[5:].strip()
                            elif line.startswith("Icon="):
                                icon = line[5:].strip()
                            elif line.startswith("NoDisplay="):
                                hidden = (line[10:].strip().lower() == "true")
                            elif line.startswith("Categories="):
                                categories = line[11:].strip()

                    apps.append({
                        "id": fname,
                        "name": sanitize_str(name, 40),
                        "exec": sanitize_str(exec_cmd, 60),
                        "icon": sanitize_str(icon, 30),
                        "hidden": hidden,
                        "categories": sanitize_str(categories, 40),
                        "is_custom": (d == APPS_DIR)
                    })
                except Exception:
                    continue
    return apps

def create_custom_entry(name, exec_cmd, icon_path="", category="Utility", in_terminal=False):
    safe_name = sanitize_str(name, 40)
    safe_id = re.sub(r'[^a-zA-Z0-9_-]', '_', safe_name.lower()) + ".desktop"
    target_path = os.path.join(APPS_DIR, safe_id)

    assigned_icon = "application-x-executable"
    if icon_path and os.path.isfile(icon_path):
        ext = os.path.splitext(icon_path)[1].lower()
        if ext in (".png", ".svg", ".jpg", ".jpeg"):
            icon_dest = os.path.join(ICONS_DIR, f"{safe_id[:-8]}{ext}")
            shutil.copyfile(icon_path, icon_dest)
            assigned_icon = icon_dest

    desktop_content = f"""[Desktop Entry]
Type=Application
Name={safe_name}
Exec={exec_cmd}
Icon={assigned_icon}
Terminal={'true' if in_terminal else 'false'}
Categories={category};
Comment=Custom shortcut managed by MenuCraft
X-Managed-By=MenuCraft
"""

    with tempfile.NamedTemporaryFile(dir=APPS_DIR, delete=False, mode="w", encoding="utf-8") as tf:
        tf.write(desktop_content)
        temp_name = tf.name
    os.replace(temp_name, target_path)
    return True

def toggle_app_visibility(app_id, hide=True):
    target_path = os.path.join(APPS_DIR, app_id)
    source_path = os.path.join("/usr/share/applications", app_id)

    if not os.path.exists(target_path) and os.path.exists(source_path):
        shutil.copyfile(source_path, target_path)

    if os.path.exists(target_path):
        lines = []
        has_nodisplay = False
        with open(target_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if line.startswith("NoDisplay="):
                    lines.append(f"NoDisplay={'true' if hide else 'false'}\n")
                    has_nodisplay = True
                else:
                    lines.append(line)
        if not has_nodisplay:
            lines.append(f"NoDisplay={'true' if hide else 'false'}\n")

        with tempfile.NamedTemporaryFile(dir=APPS_DIR, delete=False, mode="w", encoding="utf-8") as tf:
            tf.writelines(lines)
            temp_name = tf.name
        os.replace(temp_name, target_path)
        return True
    return False

def main():
    parser = argparse.ArgumentParser(description="MenuCraft Engine")
    parser.add_argument("--add", action="store_true", help="Add custom shortcut")
    parser.add_argument("--name", type=str, help="App name")
    parser.add_argument("--exec", type=str, dest="exec_cmd", help="Execution command")
    parser.add_argument("--icon", type=str, default="", help="Icon path")
    parser.add_argument("--category", type=str, default="Utility", help="Category")
    parser.add_argument("--terminal", action="store_true", help="Run in terminal")
    parser.add_argument("--hide", type=str, help="Hide .desktop file")
    parser.add_argument("--unhide", type=str, help="Unhide .desktop file")
    parser.add_argument("--list", action="store_true", help="List all applications JSON")
    
    args = parser.parse_args()

    if args.add:
        if not args.name or not args.exec_cmd:
            print("Hata: --name ve --exec zorunludur.", file=sys.stderr)
            sys.exit(1)
        success = create_custom_entry(args.name, args.exec_cmd, args.icon, args.category, args.terminal)
        print("OK" if success else "FAIL")
        sys.exit(0 if success else 1)

    elif args.hide:
        success = toggle_app_visibility(args.hide, hide=True)
        print("OK" if success else "FAIL")
        sys.exit(0 if success else 1)

    elif args.unhide:
        success = toggle_app_visibility(args.unhide, hide=False)
        print("OK" if success else "FAIL")
        sys.exit(0 if success else 1)

    elif args.list:
        print(json.dumps(list_installed_apps()))
        sys.exit(0)

    # Default: Output status and hardware JSON
    hw = get_hardware_info()
    apps = list_installed_apps()
    custom_count = sum(1 for a in apps if a.get("is_custom"))
    hidden_count = sum(1 for a in apps if a.get("hidden"))

    output = {
        "status": "OK",
        "hardware": hw,
        "total_apps": len(apps),
        "custom_shortcuts": custom_count,
        "hidden_apps": hidden_count
    }
    print(json.dumps(output))

if __name__ == "__main__":
    main()
