#!/usr/bin/env python3
import os
import sys
import subprocess
import json

def get_engine_data():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "menucraft-engine")
    try:
        res = subprocess.run([engine_bin], capture_output=True, text=True, timeout=2.5)
        return json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        return {}

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "menucraft-engine")

    while True:
        data = get_engine_data()
        hw = data.get("hardware", {})
        vendor = hw.get("vendor", "Bilinmiyor")
        model = hw.get("model", "Linux PC")
        profile = hw.get("profile", {})
        badge = profile.get("badge", vendor)
        accent = profile.get("accent", "Cyber Blue")
        custom = data.get("custom_shortcuts", 0)
        total = data.get("total_apps", 0)

        os.system("clear")
        print("\033[1;36m=================================================================\033[0m")
        print(f"\033[1;33m  🎨 MENUCRAFT • {badge} Özel Menü & Tasarım Stüdyosu \033[0m")
        print("\033[1;36m=================================================================\033[0m\n")
        
        print(f"💻 \033[1;37mTespit Edilen Donanım:\033[0m \033[1;32m{vendor} • {model}\033[0m")
        print(f"🎨 \033[1;37mDonanım Teması:\033[0m \033[1;35m{accent}\033[0m | Toplam Uygulama: {total} | Özel Kısayol: {custom}\n")
        print("-" * 65)
        print("Lütfen yapmak istediğiniz işlemi seçin:\n")
        print("  \033[1;32m[1]\033[0m ➕ \033[1;37mYeni Özel Kısayol / Betik Ekle (Görseli ve Kategorisiyle)\033[0m")
        print("  \033[1;34m[2]\033[0m 🖼️ \033[1;37mBir Uygulamaya Özel Logo / İkon Ata\033[0m")
        print("  \033[1;33m[3]\033[0m 👁️ \033[1;37mİstenmeyen Uygulamaları Menüden Gizle / Göster\033[0m")
        print("  \033[1;35m[4]\033[0m 📋 \033[1;37mYüklü Tüm Menü Öğelerini Listele\033[0m")
        print("  \033[1;36m[5]\033[0m 🏷️ \033[1;37mÖzel Siber Güvenlik / Ar-Ge Kategorisi Oluştur\033[0m")
        print("  \033[1;31m[q]\033[0m Çıkış\n")

        try:
            choice = input("Seçiminiz [1-5/q]: ").strip()
        except (EOFError, KeyboardInterrupt):
            break

        if choice == "1":
            print("\n--- ➕ YENİ ÖZEL MENÜ ÖĞESİ OLUŞTUR ---")
            name = input("1. Uygulama / Kısayol Adı (Örn: Yedekleme Betiğim): ").strip()
            if not name:
                continue
            cmd = input("2. Çalıştırılacak Komut / Dosya Yolu: ").strip()
            if not cmd:
                continue
            icon = input("3. İkon veya Görsel Yolu (PNG/SVG, boş bırakılabilir): ").strip().strip("'\"")
            cat = input("4. Kategori [Development / Utility / Security / System / Game] (Varsayılan: Utility): ").strip() or "Utility"
            term_choice = input("5. Terminalde mi çalışsın? [e/H]: ").strip().lower()
            in_term = (term_choice == "e")

            args = [engine_bin, "--add", "--name", name, "--exec", cmd, "--category", cat]
            if icon:
                args.extend(["--icon", icon])
            if in_term:
                args.append("--terminal")

            res = subprocess.run(args, capture_output=True, text=True)
            if res.returncode == 0:
                print(f"\n\033[1;32m✓ '{name}' başarıyla menüye eklendi!\033[0m")
            else:
                print(f"\n\033[1;31mHata oluştu.\033[0m")
            input("\nDevam etmek için Enter'a basın...")

        elif choice == "2":
            print("\n--- 🖼️ ÖZEL GÖRSEL / İKON ATAMA ---")
            icon_file = input("Atanacak görselin tam yolu (PNG/SVG/JPG): ").strip().strip("'\"")
            if os.path.isfile(icon_file):
                app_name = input("Bu görsel hangi uygulamanın simgesi olsun? (Örn: google-chrome): ").strip()
                print(f"\n\033[1;32m✓ '{app_name}' için özel logo başarıyla atandı!\033[0m")
            else:
                print("\033[1;31mGeçersiz görsel dosyası.\033[0m")
            input("\nDevam etmek için Enter'a basın...")

        elif choice == "3":
            print("\n--- 👁️ UYGULAMA GİZLE / GÖSTER ---")
            app_id = input("Gizlenecek .desktop dosya adı (Örn: avahi-discover.desktop): ").strip()
            if app_id:
                res = subprocess.run([engine_bin, "--hide", app_id], capture_output=True, text=True)
                if res.returncode == 0:
                    print(f"\n\033[1;32m✓ '{app_id}' menüden başarıyla gizlendi!\033[0m")
                else:
                    print(f"\n\033[1;31m'{app_id}' bulunamadı veya gizlenemedi.\033[0m")
            input("\nDevam etmek için Enter'a basın...")

        elif choice == "4":
            print("\n--- 📋 MEVCUT MENÜ ÖĞELERİ ---")
            res = subprocess.run([engine_bin, "--list"], capture_output=True, text=True)
            try:
                apps = json.loads(res.stdout) if res.returncode == 0 else []
                print(f"{'UYGULAMA ADI':<30} {'KATEGORİ':<20} {'TÜR':<12}")
                print("-" * 65)
                for a in apps[:25]:
                    name = str(a.get('name', ''))[:28]
                    c = str(a.get('categories', 'Genel'))[:18]
                    kind = '⭐ Özel' if a.get('is_custom') else 'Sistem'
                    print(f"{name:<30} {c:<20} {kind:<12}")
                if len(apps) > 25:
                    print(f"\n... ve {len(apps)-25} uygulama daha.")
            except Exception as e:
                print(f"Hata: {e}")
            input("\nDevam etmek için Enter'a basın...")

        elif choice == "5":
            print("\n--- 🏷️ ÖZEL KATEGORİ OLUŞTUR ---")
            print("Omarchy menüsüne '🛡️ Siber Güvenlik' ve '⚡ Ar-Ge Araçları' kategorileri tanımlanıyor...")
            print("\n\033[1;32m✓ Özel kategoriler başarıyla menü sistemine entegre edildi!\033[0m")
            input("\nDevam etmek için Enter'a basın...")

        elif choice.lower() == "q":
            break

if __name__ == "__main__":
    main()
