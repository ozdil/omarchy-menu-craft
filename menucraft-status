#!/usr/bin/env python3
import subprocess
import json
import os
import sys

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_path = os.path.join(plugin_dir, "menucraft-engine")

    try:
        res = subprocess.run([engine_path], capture_output=True, text=True, timeout=2.0)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        data = {}

    status = data.get("status", "UNKNOWN")
    hw = data.get("hardware", {})
    vendor = hw.get("vendor", "PC")
    model = hw.get("model", "")
    profile = hw.get("profile", {})
    accent = profile.get("accent", "Cyber Red")
    custom = data.get("custom_shortcuts", 0)
    total = data.get("total_apps", 0)

    if status == "OK":
        text = f"󰌢 {vendor}"
        css = "normal"
    else:
        text = "󰌢 Menü: Bilinmiyor"
        css = "alert"

    tooltip = f"🎨 MenuCraft • Masaüstü & Menü Stüdyosu\n• Donanım: {vendor} ({model})\n• Tema: {accent}\n• Özel Kısayollar: {custom}\n• Toplam Menü Öğesi: {total}\n\n[Sol Tık] Menü Düzenleyiciyi Aç"
    print(json.dumps({"text": text, "tooltip": tooltip, "class": css}))

if __name__ == "__main__":
    main()
